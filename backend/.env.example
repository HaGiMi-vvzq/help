APP_NAME=Campus AI Match
DEBUG=true
LOG_LEVEL=INFO

# SQLite (dev) — remove or comment out for PostgreSQL production
# DATABASE_URL is auto-configured via BACKEND_DIR in config.py

# PostgreSQL (production) — uncomment for production:
# DATABASE_URL=postgresql+asyncpg://campus:campus_prod@localhost:5432/campus_match
# REDIS_URL=redis://localhost:6379/0

# Generate a new secret key with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-random-secret-key

# DeepSeek API settings (get your key at https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# Local model paths (downloaded from HuggingFace)
QWEN_EMBED_PATH=model_cache/Qwen3-Embedding-0.6B
QWEN_RERANK_PATH=model_cache/Qwen3-Reranker-0.6B
QWEN_EMBED_MRL_DIM=0

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Connection pool (PostgreSQL only)
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10

# Error monitoring (optional)
# SENTRY_DSN=
