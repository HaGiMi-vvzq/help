APP_NAME=Campus AI Match
DEBUG=true
DATABASE_URL=sqlite+aiosqlite:///./app.db
SECRET_KEY=change-me-to-a-random-secret-key

# DeepSeek API settings (get your key at https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# Local model paths (downloaded from HuggingFace)
QWEN_EMBED_PATH=model_cache/Qwen3-Embedding-0.6B
QWEN_RERANK_PATH=model_cache/Qwen3-Reranker-0.6B
QWEN_EMBED_MRL_DIM=0
