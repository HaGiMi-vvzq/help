# ═══════════════════════════════════════════════════
# 生产环境变量 — 部署前必须修改
# 复制: cp .env.prod .env
# ═══════════════════════════════════════════════════

# Security (REQUIRED — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=change-me-to-a-random-secret-key

# Database
DB_PASSWORD=change-me-to-a-strong-password
DATABASE_URL=postgresql+asyncpg://campus:${DB_PASSWORD}@postgres:5432/campus_match

# Redis
REDIS_URL=redis://redis:6379/0

# DeepSeek API (REQUIRED)
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# Domain — your server IP or domain name
DOMAIN=your-domain.com

# Monitoring (optional — get DSN at https://sentry.io)
SENTRY_DSN=

# HTTPS (auto-generated by Let's Encrypt, no manual config needed)
LETSENCRYPT_EMAIL=admin@your-domain.com

# Runtime
DEBUG=false
LOG_LEVEL=INFO
WORKERS=4
FRONTEND_PORT=80
CORS_ALLOWED_ORIGINS=https://${DOMAIN}
